{
  "sourceLanguage" : "en",
  "strings" : {
    "%@.%@" : {
      "comment" : "A filter option in an exercise picker filter menu. The argument is the key for the localized title of the option. The argument is the string “muscleGroup”, the string “equipment” or the string “movementPattern”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@.%2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A label displaying the number of sets to perform for a given exercise. The argument is the number of sets in the program exercise.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        }
      }
    },
    "%lld-%lld" : {
      "comment" : "A range of numbers.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld-%2$lld"
          }
        }
      }
    },
    "%llds" : {
      "comment" : "A label that shows the number of seconds to rest after completing the exercise.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llds"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld วินาที"
          }
        }
      }
    },
    "•" : {
      "comment" : "A separator between the exercise's primary muscle and equipment.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "•"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "•"
          }
        }
      }
    },
